<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CryptoDash</title>
</head>
<body>
    <h1>CryptoDash</h1>
    <% coins.forEach(coin => { %>
        <li><a href="/coin/<%= coin.id %>"><%= coin.name %> - $<%= coin.current_price %></a></li>
    <% }) %>
</body>
</html>