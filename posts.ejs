<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>All Posts</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <h1>All Posts</h1>
    <a href="/posts/new">+ Write New Post</a>
    
    <% if (posts.length === 0) { %>
        <p>No posts yet. Write your first one!</p>
    <% } else { %>
        <% posts.forEach(post => { %>
            <div class="post-card">
                <h2><%= post.title %></h2>
                <p><%= post.date %></p>
                <a href="/posts/<%= post.id %>">Read More</a>
            </div>
        <% }) %>
    <% } %>
</body>
</html>